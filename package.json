{
  "name": "practice",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --ci",
    "test:watch": "jest --watch",
    "test:smoke": "jest --testPathPattern=smoke",
    "test:db": "jest --testPathPattern=db",
    "test:profile": "jest --testPathPattern=profile",
    "test:migrations": "jest --testPathPattern=migrations",
    "test:capability": "jest --testPathPattern=capability",
    "test:render": "jest --testPathPattern=render",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "precommit": "tsc --noEmit && eslint . && jest --ci --bail",
    "prepare": "husky"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^18.2.1",
    "expo": "^54.0.37",
    "expo-application": "~7.0.8",
    "expo-audio": "~1.1.1",
    "expo-constants": "^18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "^19.0.24",
    "expo-network": "~8.0.8",
    "expo-router": "^6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "llama.rn": "^0.13.0-rc.3",
    "react": "^19.1.0",
    "react-native": "^0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "whisper.rn": "^0.7.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.3.0",
    "babel-preset-expo": "^54.0.6",
    "better-sqlite3": "^13.0.3",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "react-native-worklets": "^0.12.2",
    "react-test-renderer": "^19.3.0",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}"
    ],
    "moduleNameMapper": {
      "^@op-engineering/op-sqlite$": "<rootDir>/__mocks__/op-sqlite.ts",
      "^whisper\\.rn$": "<rootDir>/__mocks__/whisper-rn.ts",
      "^llama\\.rn$": "<rootDir>/__mocks__/llama-rn.ts",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.ts",
      "^expo-file-system$": "<rootDir>/__mocks__/expo-file-system.ts",
      "^expo-network$": "<rootDir>/__mocks__/expo-network.ts",
      "^expo-device$": "<rootDir>/__mocks__/expo-device.ts",
      "^expo-application$": "<rootDir>/__mocks__/expo-application.ts",
      "^expo-speech$": "<rootDir>/__mocks__/expo-speech.ts",
      "^expo-audio$": "<rootDir>/__mocks__/expo-audio.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|zustand))"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "!app/**/*.d.ts"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
